# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="your_32_character_better_auth_secret_here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini API Key (Required for AI recipe structuring)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_actual_gemini_api_key_here"

# USDA FoodData Central API Key (Required for real nutrition data)
# Get your free API key from the USDA Developer Portal: https://fdc.nal.usda.gov/api-key-signup.html (or use DEMO_KEY)
USDA_API_KEY="DEMO_KEY"
